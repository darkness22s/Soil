#!/bin/sh
# Soil app runtime launcher. Keep the environment conservative for the
# low-RAM, software-rendered Soil desktop.
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1
export WEBKIT_DMABUF_RENDERER_FORCE_SHM=1
export WEBKIT_SKIA_ENABLE_CPU_RENDERING=1
export WEBKIT_GST_DISABLE_GL_SINK=1
export GDK_BACKEND=x11
export GSETTINGS_SCHEMA_DIR=/usr/local/share/glib-2.0/schemas
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/xdg}
export JSC_useJIT=0
export WEBKIT_DISABLE_MEMORY_PRESSURE_MONITOR=1
export WEBKIT_DISABLE_MEMORY_ATTRIBUTION=1
export WEBKIT_SKIA_CPU_PAINTING_THREADS=1
[ -d "$XDG_RUNTIME_DIR" ] || mkdir -p "$XDG_RUNTIME_DIR"
exec /usr/local/lib/soil/soil-app-bin "$@"
