<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Boxify"
           Manufacturer="Boxify"
           Version="0.1.1.0"
           UpgradeCode="34798136-5FE2-4D1F-8ADF-29B2D8123303"
           Scope="perMachine"
           Compressed="yes"
           Language="1033">
    <SummaryInformation Description="Boxify virtual machines" Manufacturer="Boxify" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Boxify is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="BoxifyIcon" SourceFile="..\Boxify\assets\boxify.ico" />
    <Property Id="ARPPRODUCTICON" Value="BoxifyIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Boxify" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Boxify" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="..\dist\Boxify\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuDir" Guid="CAF5DABA-023D-4E6E-BC69-57A631625328">
      <Shortcut Id="StartMenuShortcut"
                Name="Boxify"
                Description="Boxify virtual machines"
                Target="[INSTALLFOLDER]Boxify.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="BoxifyIcon" />
      <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\Boxify" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Boxify" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
